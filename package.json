{
  "name": "vouch",
  "version": "0.1.0",
  "private": true,
  "description": "Vouch — a per-call payment trust & reputation API for AI agents, monetized over x402.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:init": "wrangler d1 execute vouch --local --file=./src/db/schema.sql"
  },
  "comment": "Payment-critical deps are pinned EXACT (no caret): an unreviewed minor bump in signing/facilitator libs could silently change payment behavior. Bump deliberately + re-run the audit.",
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@x402/core": "2.13.0",
    "@x402/evm": "2.13.0",
    "@x402/fetch": "2.13.0",
    "@x402/hono": "2.13.0",
    "hono": "4.12.22",
    "viem": "2.50.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "agentic-flow": "^2.0.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  }
}
